{
  "expo": {
    "name": "Boltha",
    "slug": "boltha-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon/icon-1024.png",
    "userInterfaceStyle": "light",
    "scheme": "boltha",
    "splash": {
      "image": "./assets/splash/splash-1284x2778.png",
      "resizeMode": "contain",
      "backgroundColor": "#007AFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.boltha.app",
      "icon": "./assets/app-icon/icon-1024.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon/adaptive-icon.png",
        "backgroundColor": "#007AFF"
      },
      "package": "com.boltha.app",
      "icon": "./assets/app-icon/icon-1024.png"
    },
    "web": {
      "favicon": "./assets/app-icon/icon-256.png"
    }
  }
}