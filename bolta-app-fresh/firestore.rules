rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ========================================
    // HELPER FUNCTIONS
    // ========================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Check if user is trying to access their own document
    function isOwnerOfDocument(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Check if the request contains only allowed fields for user updates
    function isValidUserUpdate() {
      let allowedFields = ['name', 'profilePictureUrl', 'preferences', 'lastActive'];
      return request.resource.data.keys().hasAll(resource.data.keys()) &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFields);
    }
    
    // Check if bolt balance change is valid (only system should modify this)
    function isBoltBalanceProtected() {
      return !('boltBalance' in request.resource.data.diff(resource.data).affectedKeys()) ||
             request.resource.data.boltBalance == resource.data.boltBalance;
    }
    
    // ========================================
    // USERS COLLECTION
    // ========================================
    match /users/{userId} {
      // Read access: Users can read their own data + limited public data for leaderboard
      allow read: if isOwnerOfDocument(userId) || 
                     (isAuthenticated() && 
                      resource.data.keys().hasAll(['name', 'boltBalance', 'totalEarned']));
      
      // Create: Only during signup, with proper user ID matching auth
      allow create: if isOwnerOfDocument(userId) && 
                       isAuthenticated() &&
                       request.resource.data.uid == request.auth.uid &&
                       request.resource.data.email == request.auth.token.email &&
                       request.resource.data.boltBalance == 0 &&
                       request.resource.data.totalEarned == 0 &&
                       request.resource.data.totalSpent == 0 &&
                       request.resource.data.achievements is list;
      
      // Update: Users can only update specific fields, not financial data
      allow update: if isOwnerOfDocument(userId) && 
                       isValidUserUpdate() &&
                       isBoltBalanceProtected() &&
                       request.resource.data.uid == resource.data.uid &&
                       request.resource.data.email == resource.data.email;
      
      // Delete: Users cannot delete their own accounts (prevent data loss)
      allow delete: if false;
    }
    
    // ========================================
    // REWARDS COLLECTION
    // ========================================
    match /rewards/{rewardId} {
      // Read: Public read access for marketplace browsing
      allow read: if true;
      
      // Write: Only authenticated users can create rewards (admin function)
      // In production, you might want to add admin role checking
      allow create: if isAuthenticated() &&
                       request.resource.data.isActive is bool &&
                       request.resource.data.boltCost is int &&
                       request.resource.data.boltCost > 0 &&
                       request.resource.data.stockCount is int &&
                       request.resource.data.stockCount >= 0;
      
      // Update: Only for stock count decrements during redemption
      allow update: if isAuthenticated() &&
                       // Only allow stock count changes
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockCount', 'updatedAt']) &&
                       // Stock can only decrease or stay same (no increasing stock without admin)
                       request.resource.data.stockCount <= resource.data.stockCount &&
                       request.resource.data.stockCount >= 0;
      
      // Delete: Prevent deletion of rewards (deactivate instead)
      allow delete: if false;
    }
    
    // ========================================
    // TRANSACTIONS COLLECTION
    // ========================================
    match /transactions/{transactionId} {
      // Read: Users can only read their own transactions
      allow read: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      
      // Create: Users can create transactions for themselves with valid data
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.type in ['earn', 'spend', 'bonus'] &&
                       request.resource.data.amount is int &&
                       request.resource.data.amount != 0 &&
                       request.resource.data.description is string &&
                       request.resource.data.source in ['daily_checkin', 'reward_redemption', 'referral', 'challenge'] &&
                       request.resource.data.timestamp != null;
      
      // Update/Delete: Transactions are immutable once created
      allow update, delete: if false;
    }
    
    // ========================================
    // REDEMPTIONS COLLECTION
    // ========================================
    match /redemptions/{redemptionId} {
      // Read: Users can only read their own redemptions
      allow read: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      
      // Create: Users can create redemptions for themselves
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.boltsCost is int &&
                       request.resource.data.boltsCost > 0 &&
                       request.resource.data.rewardId is string &&
                       request.resource.data.redemptionCode is string &&
                       request.resource.data.redeemedAt != null &&
                       request.resource.data.expiresAt != null;
      
      // Update: Users can only update status of their own redemptions
      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
                       request.resource.data.status in ['completed', 'cancelled'];
      
      // Delete: Prevent deletion (use status updates instead)
      allow delete: if false;
    }
    
    // ========================================
    // ADMIN COLLECTIONS (Optional)
    // ========================================
    // Uncomment and modify if you add admin functionality
    /*
    match /admin/{document} {
      allow read, write: if isAuthenticated() && 
                           request.auth.token.admin == true;
    }
    */
    
    // ========================================
    // DENY ALL OTHER ACCESS
    // ========================================
    // Explicitly deny access to any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}