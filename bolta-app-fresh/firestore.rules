rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ========================================
    // OPTIMIZED HELPER FUNCTIONS
    // ========================================
    
    // Check if user is authenticated (cached for performance)
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user owns the resource (optimized)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Optimized user field validation
    function isValidUserUpdate() {
      let allowedFields = ['name', 'profilePictureUrl', 'preferences', 'lastActive'];
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return changedKeys.hasOnly(allowedFields);
    }
    
    // Optimized bolt balance protection
    function isBoltBalanceProtected() {
      return !('boltBalance' in request.resource.data.diff(resource.data).affectedKeys());
    }
    
    // Check if financial fields are protected
    function areFinancialFieldsProtected() {
      let protectedFields = ['boltBalance', 'totalEarned', 'totalSpent'];
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return !changedKeys.hasAny(protectedFields);
    }
    
    // Validate required user fields on creation
    function hasRequiredUserFields() {
      let required = ['uid', 'email', 'name', 'boltBalance', 'totalEarned', 'totalSpent'];
      return request.resource.data.keys().hasAll(required);
    }
    
    // Validate reward data structure
    function isValidRewardData() {
      let required = ['partnerName', 'rewardTitle', 'boltCost', 'isActive', 'stockCount'];
      return request.resource.data.keys().hasAll(required) &&
             request.resource.data.boltCost is int &&
             request.resource.data.boltCost > 0 &&
             request.resource.data.stockCount is int &&
             request.resource.data.stockCount >= 0;
    }
    
    // ========================================
    // OPTIMIZED USERS COLLECTION
    // ========================================
    match /users/{userId} {
      // Optimized read access with index-friendly queries
      allow read: if isOwner(userId) || 
                     (isAuthenticated() && 
                      resource != null &&
                      resource.data.keys().hasAll(['name', 'boltBalance', 'totalEarned']));
      
      // Optimized create with comprehensive validation
      allow create: if isOwner(userId) && 
                       hasRequiredUserFields() &&
                       request.resource.data.uid == request.auth.uid &&
                       request.resource.data.email == request.auth.token.email &&
                       request.resource.data.boltBalance == 0 &&
                       request.resource.data.totalEarned == 0 &&
                       request.resource.data.totalSpent == 0 &&
                       request.resource.data.achievements is list &&
                       request.resource.data.createdAt == request.time;
      
      // Optimized update with better field protection
      allow update: if isOwner(userId) && 
                       isValidUserUpdate() &&
                       areFinancialFieldsProtected() &&
                       request.resource.data.uid == resource.data.uid &&
                       request.resource.data.email == resource.data.email &&
                       request.resource.data.createdAt == resource.data.createdAt;
      
      // Prevent account deletion
      allow delete: if false;
    }
    
    // ========================================
    // OPTIMIZED REWARDS COLLECTION  
    // ========================================
    match /rewards/{rewardId} {
      // Optimized public read with caching hints
      allow read: if true;
      
      // Optimized create with comprehensive validation
      allow create: if isAuthenticated() &&
                       isValidRewardData() &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time;
      
      // Optimized update for stock management and admin changes
      allow update: if isAuthenticated() &&
                       (
                         // Stock count updates during redemption
                         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockCount', 'updatedAt']) &&
                          request.resource.data.stockCount < resource.data.stockCount &&
                          request.resource.data.stockCount >= 0 &&
                          request.resource.data.updatedAt == request.time) ||
                         
                         // Admin updates (add admin role check in production)
                         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive', 'boltCost', 'stockCount', 'updatedAt']) &&
                          request.resource.data.updatedAt == request.time)
                       );
      
      // Prevent deletion (use isActive instead)
      allow delete: if false;
    }
    
    // ========================================
    // OPTIMIZED TRANSACTIONS COLLECTION
    // ========================================
    match /transactions/{transactionId} {
      // Optimized read with user ownership check
      allow read: if isAuthenticated() && 
                     resource != null &&
                     resource.data.userId == request.auth.uid;
      
      // Optimized create with comprehensive validation
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.type in ['earn', 'spend', 'bonus'] &&
                       request.resource.data.amount is int &&
                       request.resource.data.amount != 0 &&
                       request.resource.data.description is string &&
                       request.resource.data.source in ['daily_checkin', 'reward_redemption', 'referral', 'challenge', 'signup_bonus', 'admin_adjustment'] &&
                       request.resource.data.timestamp == request.time &&
                       request.resource.data.metadata is map;
      
      // Transactions are immutable (audit trail)
      allow update, delete: if false;
    }
    
    // ========================================
    // OPTIMIZED REDEMPTIONS COLLECTION
    // ========================================
    match /redemptions/{redemptionId} {
      // Optimized read with ownership validation
      allow read: if isAuthenticated() && 
                     resource != null &&
                     resource.data.userId == request.auth.uid;
      
      // Optimized create with comprehensive validation
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.status in ['pending', 'processing'] &&
                       request.resource.data.boltsCost is int &&
                       request.resource.data.boltsCost > 0 &&
                       request.resource.data.rewardId is string &&
                       request.resource.data.redemptionCode is string &&
                       request.resource.data.redeemedAt == request.time &&
                       request.resource.data.expiresAt is timestamp;
      
      // Optimized update with status transition validation
      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
                       (
                         // Valid status transitions
                         (resource.data.status == 'pending' && request.resource.data.status in ['processing', 'completed', 'cancelled']) ||
                         (resource.data.status == 'processing' && request.resource.data.status in ['completed', 'cancelled', 'expired'])
                       );
      
      // Preserve redemption history (no deletion)
      allow delete: if false;
    }
    
    // ========================================
    // PERFORMANCE OPTIMIZATIONS
    // ========================================
    
    // Add indexes for common queries (define in firestore.indexes.json):
    // - users: boltBalance DESC, lastActive DESC
    // - rewards: isActive ASC, category ASC, boltCost ASC
    // - transactions: userId ASC, timestamp DESC
    // - redemptions: userId ASC, status ASC, redeemedAt DESC
    
    // ========================================
    // ADMIN COLLECTIONS (Future Enhancement)
    // ========================================
    // Uncomment when implementing admin roles
    /*
    match /admin/{document} {
      allow read, write: if isAuthenticated() && 
                           request.auth.token.admin == true &&
                           request.auth.token.email_verified == true;
    }
    
    match /analytics/{document} {
      allow read: if isAuthenticated() && 
                     request.auth.token.admin == true;
      allow write: if false; // Analytics are read-only
    }
    */
    
    // ========================================
    // SECURITY: DENY ALL OTHER ACCESS
    // ========================================
    // Explicitly deny access to any undefined collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}