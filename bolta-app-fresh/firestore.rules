rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read access to rewards (for marketplace)
    // Allow authenticated users to update reward stock counts
    match /rewards/{document} {
      allow read: if true;
      allow write: if request.auth != null; // Only authenticated users can modify rewards
    }
    
    // Allow authenticated users to access their own data fully
    // Allow authenticated users to read public user data for leaderboard functionality
    match /users/{userId} {
      // Full read/write access to own profile
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow reading other users' public data for leaderboard (authenticated users only)
      // This enables leaderboard queries while maintaining security
      allow read: if request.auth != null;
    }
    
    // Allow authenticated users to create and read redemptions
    match /redemptions/{document} {
      allow read, write: if request.auth != null;
    }
    
    // Optional: Allow users to read their own redemptions only
    // match /redemptions/{document} {
    //   allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    // }
  }
}